rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function member() { return request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
      allow read: if member();
      allow create, update: if member()
        && request.resource.data.keys().hasAll(['displayName', 'email', 'photoURL', 'providers', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'providers', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2000
        && request.resource.data.providers is list && request.resource.data.providers.size() <= 10
        && request.resource.data.createdAt is timestamp
        && (resource == null ? request.resource.data.createdAt == request.time : request.resource.data.createdAt == resource.data.createdAt)
        && request.resource.data.updatedAt == request.time;
    }
    match /visitors/{uid}/state/{key} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function validValue() {
        let value = request.resource.data.value;
        return ((key in ['favorites', 'likes', 'completed', 'checkins', 'practice-favorites']
            || key.matches('arrangements-[a-zA-Z0-9_-]{1,100}'))
            && value is list && value.size() <= 1000)
          || (key.matches('progress-[a-zA-Z0-9_-]{1,160}') && value is map
            && value.keys().hasOnly(['elapsed', 'scrollTop', 'bpm'])
            && value.elapsed is number && value.elapsed >= 0 && value.elapsed <= 86400
            && value.scrollTop is number && value.scrollTop >= 0 && value.scrollTop <= 1000000
            && value.bpm is number && value.bpm >= 40 && value.bpm <= 180);
      }
      allow read: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
        && request.resource.data.updatedAt == request.time && validValue();
      allow delete: if owner();
    }
  }
}
