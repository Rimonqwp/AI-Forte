rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /visitors/{uid}/state/{key} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function validValue() {
        let value = request.resource.data.value;
        return ((key in ['favorites', 'likes', 'completed', 'checkins', 'practice-favorites']
            || key.matches('arrangements-[a-zA-Z0-9_-]{1,100}'))
            && value is list && value.size() <= 1000)
          || (key.matches('progress-[a-zA-Z0-9_-]{1,160}') && value is map
            && value.keys().hasOnly(['elapsed', 'scrollTop', 'bpm'])
            && value.elapsed is number && value.elapsed >= 0 && value.elapsed <= 86400
            && value.scrollTop is number && value.scrollTop >= 0 && value.scrollTop <= 1000000
            && value.bpm is number && value.bpm >= 40 && value.bpm <= 180);
      }
      allow read: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
        && request.resource.data.updatedAt == request.time && validValue();
      allow delete: if owner();
    }
  }
}
